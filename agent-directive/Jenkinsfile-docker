// Stage 1: Build
//         |
//         └── Creates Docker container node:18
//                 |
//                 └── Mounts Jenkins workspace
//                 |
//                 └── Clone Node.js application
//                 |
//                 └── npm install + npm build
//                 |
//                 └── Container destroyed
//
//         Workspace remains


// Stage 2: Test
//         |
//         └── Creates Docker container node:18-alpine
//                 |
//                 └── Mounts same Jenkins workspace
//                 |
//                 └── Runs tests
//                 |
//                 └── Container destroyed
//
//         Workspace remains


// Stage 3: Deploy
//         |
//         └── Creates Docker container docker:latest
//                 |
//                 └── Mounts same Jenkins workspace
//                 |
//                 └── Deploy application
//                 |
//                 └── Container destroyed


pipeline {

    agent none

    stages {

        // Build Node.js application
        stage("Build") {

            agent {
                docker {
                    image "node:18"
                }
            }

            steps {

                echo "===== Building application inside Node container ====="

                sh '''
                    echo "Container Hostname:"
                    hostname

                    echo "Workspace:"
                    pwd

                    echo "Cloning application..."

                    git clone https://github.com/your-user/your-node-app.git .

                    echo "Installing dependencies..."

                    npm install

                    echo "Building application..."

                    npm run build


                    echo "Workspace after build:"
                    ls -la
                '''
            }
        }


        // Test Node.js application
        stage("Test") {

            agent {
                docker {
                    image "node:18-alpine"
                }
            }

            steps {

                echo "===== Testing application inside Node test container ====="

                sh '''
                    echo "Container Hostname:"
                    hostname

                    echo "Workspace:"
                    pwd

                    echo "Checking existing files from Build stage:"
                    ls -la

                    echo "Installing dependencies..."

                    npm install

                    echo "Running tests..."

                    npm test
                '''
            }
        }


        // Deploy application
        stage("Deploy") {

            agent {
                docker {
                    image "docker:latest"
                }
            }

            steps {

                echo "===== Deploying application inside Docker container ====="

                sh '''
                    echo "Container Hostname:"
                    hostname

                    echo "Workspace:"
                    pwd

                    echo "Checking application files:"
                    ls -la

                    echo "Deploying application..."

                    docker --version

                    # Example deployment command
                    # docker build -t my-node-app .

                    echo "Deployment completed"
                '''
            }
        }
    }
}
