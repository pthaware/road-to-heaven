// Stage 1: Build
//         |
//         └── Creates Docker container node:18
//                 |
//                 └── Mounts Jenkins workspace
//                 |
//                 └── Runs steps
//                 |
//                 └── Container destroyed


// Stage 2: Test
//         |
//         └── Creates Docker container node:18-alpine
//                 |
//                 └── Mounts workspace
//                 |
//                 └── Runs steps
//                 |
//                 └── Container destroyed


// Stage 3: Deploy
//         |
//         └── Creates Docker container docker:latest
//                 |
//                 └── Mounts workspace
//                 |
//                 └── Runs steps
//                 |
//                 └── Container destroyed

pipeline {
    agent none

    stages{
        // Building nodejs application inside NodeJs Build container - 01
        stage("Build"){
            agent{
                docker {
                    image "node:18"
                }
            }
            steps{
                echo "===== Building application inside Node container ====="
                sh '''
                    echo "Container Hostname:"
                    hostname

                    echo "Workspace:"
                    pwd

                    echo "Workspace Files:"
                    ls -la
                '''
            }
        }

        // Testing nodejs application inside NodeJs Test container - 02
        stage("Test"){
            agent{
                docker {
                    image "node:18-alpine"
                }
            }
            steps{
                echo "===== Testing application inside test container ====="
                sh '''
                    echo "Container Hostname:"
                    hostname

                    echo "Workspace:"
                    pwd

                    echo "Workspace Files:"
                    ls -la
                '''
            }
        }


        // Deploying nodejs application inside NodeJs deploy container - 03
        stage("Deploy"){
            agent{
                docker {
                    image "docker:latest"
                }
            }
            steps{
                echo "===== Deploying application inside test container ====="
                sh '''
                    echo "Container Hostname:"
                    hostname

                    echo "Workspace:"
                    pwd

                    echo "Workspace Files:"
                    ls -la
                '''
            }
        }
    }
}